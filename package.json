{
  "name": "@farfarfun/utools-funvideo",
  "funbuild": {
    "build": "sh build.sh"
  },
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "description": "视频工坊：基于 uTools FFmpeg 扩展的批量视频处理插件",
  "repository": "https://github.com/farfarfun-utools/utools-funvideo",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:ffmpeg": "node --test tests/ffmpeg.integration.js",
    "check": "node --check src/app.js && node --check utools/preload.js && node --check utools/tasks.js && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.4",
    "globals": "^17.14.0",
    "vite": "7.3.7"
  }
}
